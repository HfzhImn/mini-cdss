# Salin file ini jadi ".env" lalu isi dengan API key kamu.
# JANGAN commit file ".env" (sudah ada di .gitignore) -- cuma .env.example
# ini yang boleh masuk git.

# Groq -- gratis, daftar di console.groq.com, tanpa kartu kredit
GROQ_API_KEY=

# Gemini -- gratis, daftar di aistudio.google.com/apikey, tanpa kartu kredit
GEMINI_API_KEY=

# Anthropic (Claude) -- trial ~$5, daftar di console.anthropic.com,
# butuh verifikasi nomor HP. PAKAI HEMAT, cuma untuk demo caching/tool-use.
ANTHROPIC_API_KEY=

# Provider default untuk CLI testing (groq / gemini / claude)
DEFAULT_PROVIDER=groq

# Origin frontend yang diizinkan, pisahkan beberapa origin dengan koma.
# Jangan gunakan '*' bersama allow_credentials pada deployment.
CORS_ORIGINS=http://localhost:3000
